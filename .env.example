# Downloader base URL (e.g. your downloader microservice)
DOWNLOADER_URL=http://riparr:8080/api/sabnzbd

# API key to protect your Torznab indexer endpoint (leave blank or omit to disable key verification)
API_KEY=your_secure_api_key_here

# Port to run the indexer on (host port, used by docker-compose)
PORT=8000
